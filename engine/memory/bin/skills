def refresh() -> None:
    subprocess.check_call([sys.executable, str(REFRESH_SCRIPT)])


def load_index() -> dict:
    if not INDEX_PATH.exists():
        refresh()
    try:
        return json.loads(INDEX_PATH.read_text(encoding="utf-8"))
    except Exception as exc:
        raise SystemExit(f"No se pudo leer {INDEX_PATH}: {exc}")


def all_skills(index: dict) -> list[dict]:
    return index.get("ai_skills") or []


def norm(text: str) -> str:
    return re.sub(r"\s+", " ", text.lower()).strip()


def score_skill(skill: dict, query: str) -> int:
    haystack = norm(" ".join([skill.get("name", ""), skill.get("category", ""), skill.get("description", "")]))
    q = norm(query)
    score = 0
    for token in re.findall(r"[\wáéíóúñü.-]+", q):
        if token in haystack:
            score += 2
    for keyword in ROUTER_KEYWORDS.get(skill.get("name", ""), []):
        if keyword in q:
            score += 8
    if skill.get("name", "").lower() in q:
        score += 20
    return score


def format_skill(skill: dict) -> str:
    desc = (skill.get("description") or "").replace("\n", " ")
    if len(desc) > 160:
        desc = desc[:157] + "..."
    return f"{skill['ai']} | {skill['name']} | {skill['category']} | {skill['primary_path']} | {desc}"


def cmd_buscar(args: argparse.Namespace) -> None:
    rows = all_skills(load_index())
    query = " ".join(args.query)
    scored = []
    for skill in rows:
        if args.ia and skill.get("ai", "").lower() != args.ia.lower():
            continue
        score = score_skill(skill, query)
        if score or norm(query) in norm(json.dumps(skill, ensure_ascii=False)):
            scored.append((score, skill))
    for _, skill in sorted(scored, key=lambda item: (-item[0], item[1]["ai"], item[1]["name"]))[: args.limit]:
        print(format_skill(skill))
    if not scored:
        print("Sin resultados")


def cmd_recomendar(args: argparse.Namespace) -> None:
    rows = all_skills(load_index())
    query = " ".join(args.texto)
    best_by_name: dict[str, tuple[int, dict, set[str]]] = {}
    grouped: dict[str, list[dict]] = defaultdict(list)
    for skill in rows:
        if args.ia and skill.get("ai", "").lower() != args.ia.lower():
            continue
        grouped[skill["name"]].append(skill)
    for name, installs in grouped.items():
        score = max(score_skill(skill, query) for skill in installs)
        if score <= 0:
            continue
        chosen = sorted(installs, key=lambda item: item["ai"])[0]
        best_by_name[name] = (score, chosen, {item["ai"] for item in installs})
    ranked = sorted(best_by_name.values(), key=lambda item: (-item[0], item[1]["name"]))[: args.limit]
    for score, skill, ais in ranked:
        print(f"{score:02d} | {skill['name']} | {', '.join(sorted(ais))} | {skill['category']} | {skill['primary_path']}")
    if not ranked:
        print("Sin recomendacion clara")


def cmd_comparar(args: argparse.Namespace) -> None:
    rows = [skill for skill in all_skills(load_index()) if args.name.lower() in skill["name"].lower()]
    if not rows:
        print("Sin resultados")
        return
    by_name: dict[str, list[dict]] = defaultdict(list)
    for skill in rows:
        by_name[skill["name"]].append(skill)
    for name, installs in sorted(by_name.items()):
        ais = ", ".join(sorted(skill["ai"] for skill in installs))
        print(f"{name}: {ais}")
        for skill in sorted(installs, key=lambda item: item["ai"]):
            print(f"  {skill['ai']}: {skill['primary_path']}")


def cmd_resumen(args: argparse.Namespace) -> None:
    rows = all_skills(load_index())
    print("Por IA:")
    for ai, count in Counter(skill["ai"] for skill in rows).most_common():
        print(f"  {ai}: {count}")
    print("Por categoria:")
    for category, count in Counter(skill["category"] for skill in rows).most_common():
        print(f"  {category}: {count}")


def main() -> None:
    parser = argparse.ArgumentParser(prog="skills", description="Buscar y recomendar skills instaladas por IA")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("buscar", help="Buscar skills por texto")
    p.add_argument("query", nargs="+")
    p.add_argument("--ia", choices=["Codex", "Claude", "Antigravity"])
    p.add_argument("--limit", type=int, default=20)
    p.set_defaults(func=cmd_buscar)

    p = sub.add_parser("recomendar", help="Recomendar skills para una solicitud")
    p.add_argument("texto", nargs="+")
    p.add_argument("--ia", choices=["Codex", "Claude", "Antigravity"])
    p.add_argument("--limit", type=int, default=8)
    p.set_defaults(func=cmd_recomendar)

    p = sub.add_parser("comparar", help="Comparar disponibilidad de una skill por IA")
    p.add_argument("name")
    p.set_defaults(func=cmd_comparar)

    sub.add_parser("resumen", help="Conteos por IA y categoria").set_defaults(func=cmd_resumen)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
