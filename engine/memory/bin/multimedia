#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path

from portable_paths import DATA_ROOT, MEMORIA_ROOT

TOOL_ROOT = Path(__file__).resolve().parent
INDEX_PATH = DATA_ROOT / "memoria_index.json"
REFRESH_SCRIPT = TOOL_ROOT / "refresh_project_memory.py"
VAULT_ROOT = MEMORIA_ROOT
MULTIMEDIA_ROOT = VAULT_ROOT / "Multimedia"
LIBRARY_ROOT = MULTIMEDIA_ROOT / "Biblioteca"


def refresh() -> None:
    subprocess.check_call([sys.executable, str(REFRESH_SCRIPT)])


def load_index() -> dict:
    if not INDEX_PATH.exists():
        refresh()
    try:
        return json.loads(INDEX_PATH.read_text(encoding="utf-8"))
    except Exception as exc:
        raise SystemExit(f"No se pudo leer el indice de memoria: {exc}")


def assets(index: dict) -> list[dict]:
    return index.get("multimedia_assets") or []


def format_asset(asset: dict) -> str:
    return (
        f"{asset['filename']} | {asset['kind']} | {asset['owner_type']}:{asset['owner']} | "
        f"{asset['relative_path']}"
    )


def cmd_buscar(args: argparse.Namespace) -> None:
    index = load_index()
    query = " ".join(args.query).lower()
    rows = []
    for asset in assets(index):
        haystack = " ".join(
            [
                asset.get("name", ""),
                asset.get("filename", ""),
                asset.get("kind", ""),
                asset.get("owner_type", ""),
                asset.get("owner", ""),
                asset.get("relative_path", ""),
                asset.get("extension", ""),
            ]
        ).lower()
        if query in haystack:
            rows.append(asset)
    for asset in rows[: args.limit]:
        print(format_asset(asset))
    if not rows:
        print("Sin resultados")


def cmd_listar(args: argparse.Namespace) -> None:
    index = load_index()
    rows = assets(index)
    if args.tipo:
        rows = [asset for asset in rows if args.tipo.lower() in asset.get("kind", "").lower()]
    if args.owner:
        rows = [asset for asset in rows if args.owner.lower() in asset.get("owner", "").lower()]
    for asset in rows[: args.limit]:
        print(format_asset(asset))
    if not rows:
        print("Sin activos detectados")


def target_dir(args: argparse.Namespace) -> Path:
    if args.proyecto:
        base = LIBRARY_ROOT / "Proyectos" / args.proyecto
    elif args.marca:
        base = LIBRARY_ROOT / "Marcas" / args.marca
    else:
        base = LIBRARY_ROOT / "General"
    return base / args.tipo


def cmd_registrar(args: argparse.Namespace) -> None:
    source = Path(args.archivo).expanduser().resolve()
    if not source.exists() or not source.is_file():
        raise SystemExit(f"Archivo no encontrado: {source}")
    dest_dir = target_dir(args)
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / (args.nombre or source.name)
    if dest.exists() and not args.reemplazar:
        raise SystemExit(f"Ya existe: {dest}. Usa --reemplazar si quieres sobrescribirlo.")
    shutil.copy2(source, dest)
    refresh()
    print(str(dest))


def main() -> None:
    parser = argparse.ArgumentParser(prog="multimedia", description="Biblioteca local de activos multimedia para Memoria")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("buscar", help="Buscar activos por texto")
    p.add_argument("query", nargs="+")
    p.add_argument("--limit", type=int, default=30)
    p.set_defaults(func=cmd_buscar)

    p = sub.add_parser("listar", help="Listar activos detectados")
    p.add_argument("--tipo")
    p.add_argument("--owner")
    p.add_argument("--limit", type=int, default=80)
    p.set_defaults(func=cmd_listar)

    p = sub.add_parser("registrar", help="Copiar un archivo a la biblioteca multimedia y refrescar memoria")
    p.add_argument("archivo")
    p.add_argument("--proyecto")
    p.add_argument("--marca")
    p.add_argument("--tipo", default="referencias")
    p.add_argument("--nombre")
    p.add_argument("--reemplazar", action="store_true")
    p.set_defaults(func=cmd_registrar)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
