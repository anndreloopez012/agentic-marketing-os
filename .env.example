# ==============================================================================
# Agentic Marketing OS - Environment Configuration Template
# ==============================================================================

# ElevenLabs (Voces de IA, narración, efectos de sonido y aislamiento de audio)
# Obtén tu clave en: https://elevenlabs.io/app/developers/api-keys
ELEVENLABS_API_KEY=tu_clave_de_elevenlabs_aqui

# OpenAI (Generación de imágenes con DALL-E / Flux wrappers, embeddings)
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=tu_clave_de_openai_aqui

# Google Gemini (Generación multimodal, Google Veo prompts, análisis de video)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Vercel Token (Opcional: despliegue automático de landing pages y sitios)
# Obtén tu token en: https://vercel.com/account/tokens
VERCEL_TOKEN=tu_token_de_vercel_aqui

# Configuración de Rutas Locales (Opcional, sobrescribe settings.json si se define)
# OBSIDIAN_VAULT_ROOT="$HOME/Documents/Obsidian Vault"
# MARKETING_PROJECTS_ROOT="$HOME/Documents/MarketingProjects"
